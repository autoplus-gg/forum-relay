# Discord bot token from the Developer Portal.
DISCORD_TOKEN=replace-me-with-your-bot-token
# Alternative: DISCORD_TOKEN_FILE=/run/secrets/discord-token

# Database connection string used by libSQL and Drizzle.
DB_FILE_NAME=file:.data/forum-relay.db

# GitHub App credentials.
GITHUB_APP_ID=123456
# Alternative: GITHUB_APP_ID_FILE=/run/secrets/github-app-id
GITHUB_PRIVATE_KEY_PATH=./config/github-app.pem
# Alternative: GITHUB_PRIVATE_KEY_BASE64=base64-encoded-pem
GITHUB_WEBHOOK_SECRET=replace-me-with-a-random-secret
# Alternative: GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github-webhook-secret

# Public HTTP listener used for GitHub webhooks.
HOST=0.0.0.0
PORT=3000

# Optional m.ticket.pm token. Anonymous attachment proxying works without it.
# TICKETPM_TOKEN=your-ticketpm-token
# Alternative: TICKETPM_TOKEN_FILE=/run/secrets/ticketpm-token

LOG_LEVEL=info
